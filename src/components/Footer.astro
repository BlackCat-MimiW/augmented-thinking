---
import { SITE, SOCIAL, CATEGORIES } from '../data/site';
const year = new Date().getFullYear();

const icons: Record<string,string> = {
  linkedin:  '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>',
  instagram: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>',
  facebook:  '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>',
  youtube:   '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22.54 6.42a2.78 2.78 0 00-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 001.46 6.42 29 29 0 001 12a29 29 0 00.46 5.58 2.78 2.78 0 001.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 001.95-1.96A29 29 0 0023 12a29 29 0 00-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="white"/></svg>',
  threads:   '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-.505-1.891-1.408-3.355-2.688-4.35-1.348-1.04-3.144-1.578-5.328-1.595-2.782.022-4.923.907-6.364 2.63-1.394 1.67-2.103 4.1-2.12 7.233.016 3.13.725 5.561 2.12 7.23 1.44 1.725 3.582 2.61 6.363 2.63 2.437-.015 4.07-.647 5.232-2.04.403-.482.73-1.093.978-1.823-.572.066-1.13.1-1.668.1-2.25 0-4.086-.544-5.46-1.618-1.47-1.15-2.252-2.83-2.252-4.858 0-2.23.878-4.018 2.54-5.172 1.475-1.03 3.455-1.573 5.73-1.573.49 0 .967.026 1.427.077-.1-.442-.235-.84-.408-1.195C17.68 3.88 16.51 3.6 15.34 3.6c-1.172 0-2.233.35-3.18.876l-.86-1.858c1.22-.682 2.62-1.04 4.04-1.04 2.08 0 3.77.676 4.87 1.956.9 1.056 1.42 2.5 1.55 4.29.14.04.274.082.407.128 2.086.717 3.323 2.267 3.323 4.21 0 1.543-.636 2.783-1.84 3.583-.942.629-2.204.975-3.645.975-.284 0-.573-.015-.862-.043-.325 1.01-.774 1.878-1.353 2.582C17.457 20.7 15.01 21.5 12.186 24z"/></svg>',
};
---

<footer style="background:var(--ink); color:#b0aba3; margin-top:4rem;">

  <!-- 主區 -->
  <div style="max-width:72rem; margin:0 auto; padding:3rem 1.5rem 2rem; display:grid; grid-template-columns:2fr 1fr 1fr; gap:2.5rem;">

    <!-- 品牌 -->
    <div>
      <div style="font-family:'Playfair Display',serif; font-size:1.3rem; font-weight:700; color:#fff; margin-bottom:0.75rem;">
        {SITE.name}
      </div>
      <p style="font-size:0.85rem; line-height:1.8; max-width:28rem; margin:0 0 0.5rem; opacity:0.8;">
        關於 AI、商業、家庭教育與下一代思維養成的觀察筆記。
      </p>
      <p style="font-size:0.82rem; line-height:1.7; max-width:28rem; margin:0 0 1.5rem; opacity:0.6; font-style:italic;">
        我關心的不只是 AI 能做什麼，而是它將如何改變下一代成為什麼樣的人。
      </p>
      <!-- 社群圖示 -->
      <div style="display:flex; gap:14px;">
        {SOCIAL.map(s => (
          <a href={s.href} target="_blank" rel="noopener"
            aria-label={s.platform}
            style="color:#b0aba3; transition:color .15s;"
            onmouseover="this.style.color='#fff'"
            onmouseout="this.style.color='#b0aba3'">
            <Fragment set:html={icons[s.icon] ?? ''} />
          </a>
        ))}
      </div>
    </div>

    <!-- 分類 -->
    <div>
      <div style="font-family:'Inter',sans-serif; font-size:0.72rem; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:#fff; margin-bottom:1rem;">
        分類
      </div>
      {CATEGORIES.map(cat => (
        <a href={`${SITE.base}/${cat.slug}/`}
          style="display:block; font-size:0.85rem; padding:4px 0; color:#b0aba3; transition:color .15s;"
          onmouseover="this.style.color='#fff'"
          onmouseout="this.style.color='#b0aba3'">
          {cat.label}
        </a>
      ))}
    </div>

    <!-- 快速連結 -->
    <div>
      <div style="font-family:'Inter',sans-serif; font-size:0.72rem; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:#fff; margin-bottom:1rem;">
        關於
      </div>
      {[
        { label:'關於作者',  href:`${SITE.base}/about/` },
        { label:'訂閱 RSS', href:`${SITE.base}/subscribe/` },
        { label:'RSS Feed', href:`${SITE.base}/rss.xml` },
      ].map(l => (
        <a href={l.href}
          style="display:block; font-size:0.85rem; padding:4px 0; color:#b0aba3; transition:color .15s;"
          onmouseover="this.style.color='#fff'"
          onmouseout="this.style.color='#b0aba3'">
          {l.label}
        </a>
      ))}
    </div>
  </div>

  <!-- 底部版權 -->
  <div style="border-top:1px solid rgba(255,255,255,0.1); max-width:72rem; margin:0 auto; padding:1rem 1.5rem; display:flex; justify-content:space-between; align-items:center;">
    <span style="font-size:0.78rem; opacity:0.5;">© {year} {SITE.name}. All rights reserved.</span>
    <a href={`${SITE.base}/rss.xml`} style="font-size:0.78rem; opacity:0.5; display:flex; align-items:center; gap:5px;"
      onmouseover="this.style.opacity='0.9'"
      onmouseout="this.style.opacity='0.5'">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="19" r="3"/><path d="M4 4a16 16 0 0116 16M4 11a9 9 0 019 9"/></svg>
      RSS Feed
    </a>
  </div>
</footer>

<style>
  @media (max-width: 768px) {
    footer > div:first-child { grid-template-columns: 1fr !important; }
  }
</style>
