---
import { SITE, CATEGORIES } from '../data/site';
const path = Astro.url.pathname;
---

<header style="border-bottom:1px solid var(--border); background:rgba(255,255,255,0.95); backdrop-filter:blur(10px); position:sticky; top:0; z-index:50;">
  <div style="background:var(--ink); height:3px;"></div>
  <div style="max-width:72rem; margin:0 auto; padding:0 1.5rem;">

    <!-- Logo 行 -->
    <div style="display:flex; align-items:center; justify-content:space-between; padding:1rem 0 0.75rem; border-bottom:1px solid var(--border);">
      <a href={`${SITE.base}/`} style="font-family:'Playfair Display',serif; font-size:1.5rem; font-weight:700; color:var(--ink); letter-spacing:-0.5px;">
        {SITE.name}
      </a>
      <div style="display:flex; align-items:center; gap:12px;">
        <a href={`${SITE.base}/subscribe/`}
          style="font-family:'Inter',sans-serif; font-size:0.78rem; font-weight:500; border:1px solid var(--ink); padding:5px 14px; color:var(--ink); transition:all .15s;"
          onmouseover="this.style.background='var(--ink)';this.style.color='#fff'"
          onmouseout="this.style.background='transparent';this.style.color='var(--ink)'">
          訂閱 RSS
        </a>
        <button id="mob-btn" style="display:none; background:none; border:none; cursor:pointer; padding:4px;" aria-label="選單">
          <svg width="22" height="16" viewBox="0 0 22 16"><line x1="0" y1="2" x2="22" y2="2" stroke="var(--ink)" stroke-width="2"/><line x1="0" y1="8" x2="22" y2="8" stroke="var(--ink)" stroke-width="2"/><line x1="0" y1="14" x2="22" y2="14" stroke="var(--ink)" stroke-width="2"/></svg>
        </button>
      </div>
    </div>

    <!-- 桌面導覽（全部分類直接顯示） -->
    <nav id="desk-nav" style="display:flex; align-items:center; flex-wrap:wrap; padding:0;">
      {CATEGORIES.map(cat => (
        <a href={`${SITE.base}/${cat.slug}/`}
          style={`font-family:'Inter',sans-serif; font-size:0.8rem; font-weight:500; padding:0.6rem 0.85rem; letter-spacing:0.02em; color:${path.includes(cat.slug) ? 'var(--ink)' : 'var(--muted)'}; border-bottom:${path.includes(cat.slug) ? '2px solid var(--ink)' : '2px solid transparent'}; transition:color .15s; white-space:nowrap;`}>
          {cat.label}
        </a>
      ))}
    </nav>

    <!-- 手機選單 -->
    <nav id="mob-menu" style="display:none; flex-direction:column; border-top:1px solid var(--border); padding:0.5rem 0 1rem;">
      {CATEGORIES.map(cat => (
        <a href={`${SITE.base}/${cat.slug}/`}
          style="font-family:'Inter',sans-serif; font-size:0.9rem; padding:0.65rem 0; color:var(--text); border-bottom:1px solid var(--border);">
          {cat.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  @media (max-width: 768px) {
    #desk-nav { display: none !important; }
    #mob-btn  { display: block !important; }
  }
</style>

<script>
  document.getElementById('mob-btn')?.addEventListener('click', () => {
    const m = document.getElementById('mob-menu');
    if (m) m.style.display = m.style.display === 'none' ? 'flex' : 'none';
  });
</script>
